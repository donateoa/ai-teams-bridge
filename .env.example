# Firebase project (from your AI Teams Firebase project settings)
AI_TEAMS_FIREBASE_API_KEY=
AI_TEAMS_FIREBASE_AUTH_DOMAIN=
AI_TEAMS_FIREBASE_PROJECT_ID=
AI_TEAMS_FIREBASE_APP_ID=

# Google OAuth Desktop client (Google Cloud Console -> APIs & Services -> Credentials)
AI_TEAMS_GOOGLE_CLIENT_ID=
AI_TEAMS_GOOGLE_CLIENT_SECRET=

# Optional: Claude Code permission mode (plan | acceptEdits | default)
AI_TEAMS_PERMISSION_MODE=default
